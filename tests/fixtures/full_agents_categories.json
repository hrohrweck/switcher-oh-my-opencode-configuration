{
  "$schema": "https://example.com/schema.json",
  "model_fallback": true,
  "runtime_fallback": {
    "enabled": true,
    "retry_on_errors": [429, 503],
    "max_fallback_attempts": 3,
    "cooldown_seconds": 60
  },
  "agents": {
    "sisyphus": {
      "model": "openai/gpt-5",
      "variant": "max",
      "reasoning": "high",
      "fallback_models": [
        {"model": "kimi/k3", "variant": "max"},
        {"model": "deepseek/v4", "variant": "max"}
      ]
    },
    "oracle": {
      "model": "openai/gpt-5.6",
      "variant": "xhigh",
      "fallback_models": [
        {"model": "kimi/k3", "variant": "max"},
        {"model": "zai/glm-5.2", "variant": "max"}
      ]
    }
  },
  "categories": {
    "quick": {
      "model": "openai/gpt-4o-mini",
      "fallback_models": [
        {"model": "deepseek/v4-flash"}
      ]
    },
    "deep": {
      "model": "openai/gpt-5",
      "variant": "high",
      "fallback_models": [
        {"model": "kimi/k3", "variant": "max"}
      ]
    }
  }
}
